{
  "file_format_version" : "1.0.0",
  "layer" : {
    "name": "VK_LAYER_BLOCK_post_processing@arch_suffix@",
    "type": "GLOBAL",
    "library_path": "@ld_lib_dir_vkshade@block@lib_suffix@",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "Block — ReShade-compatible Vulkan post-processing (vkShade fork)",
    "functions": {
      "vkGetInstanceProcAddr": "vkShade_GetInstanceProcAddr",
      "vkGetDeviceProcAddr":   "vkShade_GetDeviceProcAddr"
    },
    "enable_environment": {
      "ENABLE_BLOCK": "1"
    },
    "disable_environment": {
      "DISABLE_BLOCK": "1"
    }
  }
}
