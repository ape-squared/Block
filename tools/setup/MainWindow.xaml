<Window x:Class="Block.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block Setup"
        Width="760" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource Surface1}"
        Icon="Assets/block.ico"
        FontFamily="Segoe UI">

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface1}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" Background="{StaticResource Surface0}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseDown">
        <DockPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image Source="Assets/title-icon.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Block Setup" Margin="10,0,0,0" Foreground="{StaticResource InkMuted}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="46" Height="36" Click="Minimize_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Minimise">
              <TextBlock Text="─" Foreground="{StaticResource InkMuted}" FontSize="12"/>
            </Button>
            <Button Width="46" Height="36" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close">
              <TextBlock Text="✕" Foreground="{StaticResource InkMuted}" FontSize="12"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Surface0}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="20,24">
          <DockPanel>
            <Image DockPanel.Dock="Top" Source="Assets/lockup.png" Width="120" HorizontalAlignment="Left"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,18"/>
            <TextBlock DockPanel.Dock="Bottom" Text="v0.3.2 · x64" Foreground="{StaticResource InkMuted}"
                       FontFamily="Consolas" FontSize="11" VerticalAlignment="Bottom"/>
            <StackPanel x:Name="StepNav" Margin="0,8,0,0" VerticalAlignment="Top"/>
          </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Margin="30,28,30,0">
          <!-- 1 Welcome -->
          <StackPanel x:Name="PageWelcome" Visibility="Visible">
            <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12">
              <Run Text="Welcome to Block"/><Run Text="." Foreground="{StaticResource Signal}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{StaticResource InkMuted}" Margin="0,0,0,16"
                       Text="Post-processing for Second Life viewers. Block injects into the OpenGL viewer you choose, uses your GShade shader pack when present, and opens with Shift+B."/>
            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource Ink}" Text="• GShade presets (extracts preset zips under gshade-presets\)"/>
                <TextBlock Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource Ink}" Text="• Local addons only (safe for OpenGL — no DXGI/DLSS seeds)"/>
                <TextBlock FontSize="13" Foreground="{StaticResource Ink}" Text="• Overlay hotkey: Shift+B"/>
              </StackPanel>
            </Border>
            <CheckBox x:Name="AgreeBox" IsChecked="True" FontSize="13" Foreground="{StaticResource InkMuted}"
                      Checked="AgreeBox_Changed" Unchecked="AgreeBox_Changed">
              <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InkMuted}">
                I agree to the licence. Block is independent and not affiliated with Linden Lab.
              </TextBlock>
            </CheckBox>
          </StackPanel>

          <!-- 2 Options / viewers -->
          <DockPanel x:Name="PageOptions" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Text="Choose viewers" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14"/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
              <Button Style="{StaticResource GhostBtn}" Content="Rescan" Click="Rescan_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource GhostBtn}" Content="Browse…" Click="Browse_Click"/>
              <TextBlock x:Name="StatusHint" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                         FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Ok}" Text="Injector ready"/>
            </DockPanel>
            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ViewerList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                              CornerRadius="6" Padding="12" Margin="0,0,0,8" Cursor="Hand"
                              MouseLeftButtonUp="ViewerRow_Click" Tag="{Binding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource InkMuted}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Signal}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </DockPanel>

          <!-- 3 Installing -->
          <StackPanel x:Name="PageInstall" Visibility="Collapsed">
            <TextBlock Text="Installing Block" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,16"/>
            <DockPanel Margin="0,0,0,8">
              <TextBlock x:Name="ProgressLabel" Text="Preparing…" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="ProgressPct" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="0%"
                         FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Signal}"/>
            </DockPanel>
            <Border Height="8" Background="{StaticResource Surface3}" CornerRadius="2" Margin="0,0,0,16">
              <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Height="8" Background="{StaticResource Signal}" CornerRadius="2"/>
            </Border>
            <Border Background="{StaticResource Surface0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,12" MaxHeight="220">
              <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <!-- 4 Done -->
          <StackPanel x:Name="PageDone" Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="10" Background="{StaticResource Signal}" Margin="0,0,0,16" HorizontalAlignment="Left">
              <TextBlock Text="✓" FontSize="28" FontWeight="Bold" Foreground="#FF0B0C0E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12">
              <Run Text="Block is ready"/><Run Text="." Foreground="{StaticResource Signal}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{StaticResource InkMuted}" Margin="0,0,0,16"
                       Text="Launch your viewer. In-world, press Shift+B to open the overlay. Browse presets from gshade-presets\."/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Footer -->
      <Border Grid.Row="2" Background="{StaticResource Surface0}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnSecondary" Style="{StaticResource GhostBtn}" Content="Cancel" Click="Secondary_Click" Margin="0,0,8,0"/>
          <Button x:Name="BtnPrimary" Style="{StaticResource SignalBtn}" Content="Next" Click="Primary_Click" MinWidth="88"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
